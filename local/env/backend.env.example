# Local development environment.
# Copy to backend.env and fill in real values. local\scripts\start.ps1 copies
# backend.env to backend\.env on every start, so never edit backend\.env directly.

# PostgreSQL connection URL. Leave unset to use the built-in local default:
# host=localhost user=finance password=finance dbname=financetracker port=5432 sslmode=disable
# DATABASE_URL=postgresql://finance:finance@localhost:5432/financetracker?sslmode=disable

# HTTP port (local default is 8080).
# PORT=8080

# JWT signing secret. A dev default is used when unset locally.
# JWT_SECRET=local-dev-secret

# Cloudflare Turnstile secret for registration. The site key is embedded in the app.
TURNSTILE_SECRET=

# Optional: email OTP (password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: SMS OTP via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional: local NSE ISIN CSV when download fails
# NSE_EQUITY_CSV_PATH=data/EQUITY_L.csv
