# Production (OCI) environment.
# Copy to backend.env and fill in real values. This file is the source of truth for
# /opt/financetracker/.env on the server, which financetracker.service loads via
# EnvironmentFile. Deploy scripts never upload it automatically; update the server
# copy deliberately when a value changes.

# PostgreSQL on the OCI host.
DATABASE_URL=postgresql://finance:CHANGE_ME@127.0.0.1:5432/financetracker?sslmode=disable

PORT=8080

# Required in production.
JWT_SECRET=CHANGE_ME

GIN_MODE=release

# Cloudflare Turnstile secret for registration.
TURNSTILE_SECRET=

# Optional: email OTP (password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: SMS OTP via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
