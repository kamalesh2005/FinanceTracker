# Production (OCI) environment.
# Copy to backend.env and fill in real values. This file is the source of truth for
# /opt/financetracker/.env on the server, which financetracker.service loads via
# EnvironmentFile. Deploy scripts never upload it automatically; update the server
# copy deliberately when a value changes.

# PostgreSQL on the OCI host.
DATABASE_URL=postgresql://finance:CHANGE_ME@127.0.0.1:5432/financetracker?sslmode=disable

PORT=8080

# Required in production.
JWT_SECRET=CHANGE_ME

# Refresh token lifetime in days (default 30).
# REFRESH_TOKEN_TTL_DAYS=30

GIN_MODE=release

# Cloudflare Turnstile secret for registration.
TURNSTILE_SECRET=

# Google Sign-In (OAuth 2.0 Web client ID). Leave unset to hide the button.
# GOOGLE_CLIENT_ID=

# OCI Email Delivery (ap-mumbai-1), STARTTLS on 587.
# SMTP_USER / SMTP_PASS come from OCI Console → Email Delivery → SMTP Credentials.
# Quote SMTP_PASS if it contains # or ; (systemd EnvironmentFile comment chars).
SMTP_HOST=smtp.email.ap-mumbai-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@dhanshanti.com

# Optional: SMS OTP via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
