# Copy to .env for local overrides (do not commit .env).
# Cloud hosts (Railway, Render, Fly, etc.) set these in the dashboard.

# PostgreSQL connection URL (Railway/Render provide this automatically).
# Local default when unset: host=localhost user=finance password=finance dbname=financetracker port=5432 sslmode=disable
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# HTTP port (cloud platforms inject this; local default is 8080).
# PORT=8080

# JWT signing secret (required in production; dev default used when unset locally).
# JWT_SECRET=change-me-in-production

# Optional: email OTP (password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: SMS OTP via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional: local NSE ISIN CSV when download fails
# NSE_EQUITY_CSV_PATH=data/EQUITY_L.csv
